# URL base de voting_api (POST /vote y GET /catalog)
NEXT_PUBLIC_VOTING_API_URL=http://localhost:8080

# Endpoints STOMP de los dashboard workers (transporte WebSocket nativo de SockJS)
NEXT_PUBLIC_WS_GLOBAL_URL=ws://localhost:8080/ws/results/websocket
NEXT_PUBLIC_WS_REGIONAL_URL=ws://localhost:8081/ws/results/websocket

# 1 = funciona sin backend con datos simulados y muestra el aviso "Datos simulados"
# NEXT_PUBLIC_DEMO=1
