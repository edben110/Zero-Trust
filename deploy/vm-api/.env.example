# Copiar a .env (no se sube al repositorio).
IMAGE_TAG=1.0
VM_AUTH_IP=192.168.56.11
VM_BROKERS_IP=192.168.56.12
CLIENT_SECRET=secreto-de-voting_api
TRUSTSTORE_PASSWORD=cambiar
# Eleccion en curso y clave HMAC (Base64, minimo 32 bytes). IGUALES en vm-init; no cambiar durante la eleccion.
# Generar la clave: openssl rand -base64 32
ELECTION_ID=elecciones-2026
VOTER_HMAC_KEY=
POSTGRES_DB=zerotrust
DB_USER=zerotrust
DB_PASSWORD=cambiar
# Origen exacto del front (vm-app, puerto 3000), sin comodin.
CORS_ALLOWED_ORIGINS=http://192.168.56.16:3000
# true solo detras de un proxy de confianza.
TRUST_FORWARDED_HEADERS=false
RPC_TIMEOUT_MS=3000
# Token compartido con el front (vm-app) para el panel de administracion. Minimo 32 caracteres.
# Generar: openssl rand -hex 32
ADMIN_API_TOKEN=
