# Copiar a .env (no se sube al repositorio).
IMAGE_TAG=1.0
VM_AUTH_IP=192.168.56.11
VM_BROKERS_IP=192.168.56.12
VM_API_IP=192.168.56.13
# Panel de administracion. ADMIN_API_TOKEN es el mismo de vm-api. Secretos de 32 caracteres o mas.
ADMIN_API_TOKEN=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
TRUSTSTORE_PASSWORD=cambiar
SECRET_GLOBAL_DASHBOARD_WORKER=
SECRET_REGIONAL_DASHBOARD_WORKER=
DASHBOARD_ALLOWED_ORIGINS=http://192.168.56.16:3000,http://localhost:3001
# URLs que usa el navegador (IP o nombre de vm-api y vm-app).
PUBLIC_VOTING_API_URL=http://192.168.56.13
PUBLIC_WS_GLOBAL_URL=ws://192.168.56.16:8080/ws/results/websocket
PUBLIC_WS_REGIONAL_URL=ws://192.168.56.16:8082/ws/results/websocket
